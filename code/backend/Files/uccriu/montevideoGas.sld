<StyledLayerDescriptor version="1.0.0">
	<NamedLayer>
		<Name>Montevideo Gas</Name>
			<UserStyle>
				<FeatureTypeStyle>
					<Rule>
						<LineSymbolizer>
							<Stroke>
<!--  Todo referente a gas pasa a ser amarillo 18/11/2020
								<CssParameter name="stroke">#3F33FF</CssParameter>
-->
