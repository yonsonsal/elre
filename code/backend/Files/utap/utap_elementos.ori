<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="e_utap_elemento">
	<atributo nombre="punto_alimentacion" tipo="imm.gis.core.feature.FeatureReferenceAttribute" capa_referenciada="utap:e_utap_punto_alimentacion" nillable="true"/>
	<atributo nombre="linea" tipo="imm.gis.core.feature.FeatureReferenceAttribute" capa_referenciada="utap:e_utap_tramo_linea" nillable="true"/>
	<atributo nombre="puesta" tipo="imm.gis.core.feature.FeatureReferenceAttribute" capa_referenciada="utap:e_utap_puesta" nillable="true"/>
	<atributo nombre="desc_tipo_elemento" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoElemento()" persistible="true" capa_referenciada="Tipo Elemento"/>
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Point"/>
	
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
	<atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    	<atributo nombre="Fact" tipo="java.util.Date"/>


	<origen_datos>
		<workspace nombre="utap" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="e_utap_elemento" nombre_mostrar="e_utap_elemento"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS" />
		
		<tabla nombre="utap_elemento" pk="gid" esquema="public">
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="cod_tipo_elemento" nombre_capa="desc_tipo_elemento"/>
			<atributo_tabla nombre_bd="id_punto_alimentacion" nombre_capa="punto_alimentacion"/>
			<atributo_tabla nombre_bd="id_puesta" nombre_capa="puesta"/>
			<atributo_tabla nombre_bd="id_linea" nombre_capa="linea"/>
			
			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>
		</tabla>
	</origen_datos>
</capa>
</tema>
