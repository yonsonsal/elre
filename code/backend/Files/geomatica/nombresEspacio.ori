<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="mdg_nombres_espacios">
	
	<atributo nombre="cod_nom_espacio" tipo="java.lang.String"/>	
	  		
	<origen_datos>
		<workspace nombre="geomatica" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="mdg_nombres_espacios" nombre_mostrar="mdg_nombres_espacios"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="mdg_nombres_espacios" esquema="public" pk="cod_nom_espacio" comboValue="cod_nom_espacio" comboLabel="nom_espacio">	
			<atributo_tabla nombre_bd="nom_espacio" nombre_capa="cod_nom_espacio"/>
		</tabla>
	</origen_datos>
    </capa>
</tema>

