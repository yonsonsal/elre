	<atributo nombre="nombre" tipo="java.lang.String"/>
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Polygon"/>	
	
	<origen_datos>
	<workspace nombre="sfm" tipo="WFS">
			<style strokeColor="#0000FF"  strokeWidth="3"  fillColor="#000000AA" />
			<capapublicada nombre="c_sf_barrios" nombre_mostrar="Barrios">
			</capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="sig_barrios" pk="gid">
		<atributo_tabla nombre_bd="barrio" nombre_capa="nombre"/>
		</tabla>
	</origen_datos>
</capa>
</tema>
