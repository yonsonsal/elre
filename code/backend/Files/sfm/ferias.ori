		  <atributo_tabla nombre_bd="FECHA_ROTACION" nombre_capa="Fecha_rotacion"/>
		  <atributo_tabla nombre_bd="OBSERVACIONES" nombre_capa="Observaciones"/>		
		  <atributo_tabla nombre_bd="LINK_PLANO_FERIA" nombre_capa="Plano_feria"/>		
		  <atributo_tabla nombre_bd="UCREA" nombre_capa="Ucrea"/>
