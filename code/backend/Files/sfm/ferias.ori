		  <atributo_tabla nombre_bd="COD_TIPO" nombre_capa="Tipo_de_feria"/>		
		  <atributo_tabla nombre_bd="BARRIO" nombre_capa="Barrio"/>		
		  <atributo_tabla nombre_bd="ARMADO" nombre_capa="Armado"/>	
		  <atributo_tabla nombre_bd="HORA_COMIENZO" nombre_capa="Hora_comienzo"/>
		  <atributo_tabla nombre_bd="HORA_FIN" nombre_capa="Hora_fin"/>
		  <atributo_tabla nombre_bd="LEVANTADO" nombre_capa="Levantado"/>	
		  <atributo_tabla nombre_bd="CANT_PUESTOS" nombre_capa="Cantidad_puestos"/>		
