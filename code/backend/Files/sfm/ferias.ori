<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="e_sf_feria" grupo="Capas editables">		
        <atributo nombre="Codigo" tipo="java.lang.String"/> 
        <atributo nombre="Responsable"  tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Responsable"/>	
	<atributo nombre="Dia_de_feria" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Dias de feria" />	
	<atributo nombre="Ambito_territorial" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Codigos comunales" />		
	<atributo nombre="Numero_feria" tipo="java.lang.Integer" nillable="true"/>	
        <atributo nombre="Denominacion" tipo="java.lang.String" nillable="true"/>		
        <atributo nombre="Ubicacion" tipo="java.lang.String" nillable="true"/>  
	<atributo nombre="Tipo_de_feria" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Tipos de feria" />			
	<atributo nombre="Barrio" tipo="java.lang.String" valorCalculado="python::calcularBarrioSfm()" persistible="true"/>		
	<atributo nombre="Armado" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Armado"/>
	<atributo nombre="Hora_comienzo" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Hora comienzo"/>
	<atributo nombre="Hora_fin" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Hora fin"/>
	<atributo nombre="Levantado" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Levantado"/>	
        <atributo nombre="Cantidad_puestos" tipo="java.lang.Integer" nillable="true"/>		
	<atributo nombre="Fecha_instalacion" tipo="java.util.Date"/>
	<atributo nombre="Fecha_rotacion" tipo="java.util.Date"/>		
        <atributo nombre="Observaciones" tipo="java.lang.String" nillable="true"/>
	<atributo nombre="Plano_feria" tipo="java.lang.String" nillable="true"/>
        <atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
        <atributo nombre="Fact" tipo="java.util.Date"/>		
	<atributo nombre="idauditoria" tipo="java.lang.String" />
        <atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Polygon"/>		
      
	<origen_datos>
	  <workspace nombre="sfm" tipo="WFS">
			<style strokeColor="#0000FF"  strokeWidth="3"  fillColor="#000000AA" />
			<capapublicada nombre="e_sf_feria" nombre_mostrar="e_sf_feria">
			</capapublicada>
		</workspace>
		<fuente nombre="brfDS" tipo="ORACLE"/>
		<tabla nombre="SF_FERIA"  pk="GID" secuencia="S_SFFERI">
		  <atributo_tabla nombre_bd="GID" nombre_capa="GID" />	
		  <atributo_tabla nombre_bd="COD_FERIA" nombre_capa="Codigo"/>		
