<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="e_ep_inspeccion_relojes">

	<atributo nombre="gid_reloj" tipo="imm.gis.core.feature.FeatureReferenceAttribute" capa_referenciada="Relojes Termometros"/>
	<atributo nombre="Estado" tipo="java.lang.String"/>	
	<atributo nombre="Funcionamiento" tipo="java.lang.String"/>	
	<atributo nombre="Fecha" tipo="java.util.Date"/>	
	
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
    <atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    <atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>	
		
	<origen_datos>
		<workspace nombre="gep" tipo="WFS">
			<style strokeColor="#0000FF"  strokeWidth="3"  fillColor="#000000AA" />
			<capapublicada nombre="e_ep_inspeccion_relojes" nombre_mostrar="e_ep_inspeccion_relojes">
			</capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="ep_inspeccion_relojes" esquema="ciudadanos" pk="cod_insp_rel">	
			<atributo_tabla nombre_bd="cod_insp_rel" nombre_capa="cod_insp_rel"/>		
			<atributo_tabla nombre_bd="gid_reloj" nombre_capa="gid_reloj"/>
			<atributo_tabla nombre_bd="estado" nombre_capa="Estado"/>
			<atributo_tabla nombre_bd="funcionamiento" nombre_capa="Funcionamiento"/>
			<atributo_tabla nombre_bd="fecha" nombre_capa="Fecha"/>			

			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>			
  			
		</tabla>
	</origen_datos>
    </capa>
</tema>

