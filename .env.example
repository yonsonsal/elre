# ============================================================
# Archivo de variables de entorno para Docker Compose
# ============================================================
# Copiar a .env y ajustar valores segun necesidad
# ============================================================

# Configuracion de PostgreSQL + PostGIS
POSTGIS_VERSION_TAG=16-3.4
POSTGRES_DB=gis_database
POSTGRES_USER=gis_user
POSTGRES_PASS=gis_password
POSTGRES_PORT=5432
ALLOW_IP_RANGE=0.0.0.0/0

# Configuracion de GeoServer
GS_VERSION=2.25.1
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
GEOWEBCACHE_CACHE_DIR=/opt/geoserver/gwc
GEOSERVER_CONTEXT_ROOT=geoserver

# Memoria para GeoServer (ajustar segun recursos disponibles)
INITIAL_MEMORY=2G
MAXIMUM_MEMORY=4G

# Extensiones de GeoServer
STABLE_EXTENSIONS=wps,csw,inspire,importer
COMMUNITY_EXTENSIONS=

# Nivel de logging (WARNING, INFO, FINE, FINER, FINEST)
CONSOLE_HANDLER_LEVEL=WARNING

# URL publica para exponer la demo afuera de tu red (Cloudflare Tunnel, ver servicio
# "cloudflared" con --profile tunnel; ngrok tambien funciona pero su free tier interpone una
# pagina de confirmacion que traba al instalador de QGIS).
# Vacio = todo usa http://localhost:8080 (default, uso local sin tunel).
# Al setearla, alimenta DOS cosas a la vez (hay que recrear ambos servicios despues de cambiarla):
#   1. GeoServer mismo (PROXY_BASE_URL, service "geoserver") - asi sus capabilities documents y
#      redirecciones de login apuntan al host publico en vez de a localhost.
#      docker compose up -d geoserver
#   2. El plugin QGIS que se sirve desde el repo embebido (urlApi/urlCapas) -
#      ver code/frontend/publish-plugin-repo.sh.
#      docker compose --profile publish up plugin-repo-publisher
# Ejemplo: PLUGINETA_PUBLIC_URL=https://random-words.trycloudflare.com
PLUGINETA_PUBLIC_URL=

# Whitelist de dominios para la proteccion CSRF del panel web de administracion de GeoServer
# (Wicket) - sin esto, accediendo por un dominio distinto a localhost (el tunel de arriba), las
# acciones AJAX del admin (ej. editar reglas en Data Security) fallan con 400 "Origin does not
# correspond to request". Por sufijo de dominio, cubre cualquier subdominio aleatorio de un mismo
# proveedor sin tener que actualizarlo por sesion. Ver
# https://docs.geoserver.org/stable/en/user/security/webadmin/csrf.html
# Default ya cubre Cloudflare Tunnel y ngrok; agregar mas dominios separados por coma si hace
# falta.
GEOSERVER_CSRF_WHITELIST=trycloudflare.com,ngrok-free.app
