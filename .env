# Configuración de PostgreSQL + PostGIS
POSTGIS_VERSION_TAG=16-3.4
POSTGRES_DB=gis_database
POSTGRES_USER=gis_user
POSTGRES_PASS=gis_password
POSTGRES_PORT=5432
ALLOW_IP_RANGE=0.0.0.0/0

# Configuración de GeoServer
GS_VERSION=2.25.1
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
GEOWEBCACHE_CACHE_DIR=/opt/geoserver/gwc
GEOSERVER_CONTEXT_ROOT=geoserver

# Memoria para GeoServer
INITIAL_MEMORY=2G
MAXIMUM_MEMORY=4G

# Extensiones de GeoServer
STABLE_EXTENSIONS=wps,csw,inspire,importer,gdal
COMMUNITY_EXTENSIONS=

# Nivel de logging
CONSOLE_HANDLER_LEVEL=WARNING
