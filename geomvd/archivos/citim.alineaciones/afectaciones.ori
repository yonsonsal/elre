<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="e_citim_afectaciones">

	<atributo nombre="nro_padron" tipo="java.lang.Integer" valorCalculado="uy.ciemsa.geomvd.citim.fields.AfectacionesCalcs::getPadron(the_geom)" persistible="true" />
        <atributo nombre="afectado" tipo="java.lang.Boolean" valorCalculado="python::getAfectado()" persistible="true" />
        <atributo nombre="vigente" tipo="java.lang.Boolean" valorCalculado="python::getVigente()" persistible="true"/>
	<atributo nombre="fecha_certificado" tipo="java.util.Date" persistible="true" />
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
	<atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
	<atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>	
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Point"/>
	
	<origen_datos>
		<workspace nombre="citim.alineaciones" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="e_citim_afectaciones" nombre_mostrar="e_citim_afectaciones"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="citim_afectaciones" esquema="public" pk="gid" secuencia="gid_global_seq"> 
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />	
			<atributo_tabla nombre_bd="nro_padron" nombre_capa="nro_padron"/>
			<atributo_tabla nombre_bd="fecha_certificado" nombre_capa="fecha_certificado"/>
			<atributo_tabla nombre_bd="afectado" nombre_capa="afectado"/>
			<atributo_tabla nombre_bd="vigente" nombre_capa="vigente"/>
			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>
		</tabla>
	</origen_datos>
</capa>
</tema>

