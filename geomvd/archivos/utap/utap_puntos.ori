<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="e_utap_punto_alimentacion">

	<atributo nombre="nis" nillable="true" tipo="java.lang.String"/>
	<atributo nombre="nro_cuenta" nillable="true" tipo="java.lang.String"/>
	<atributo nombre="tipo_alimentacion" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoAlimentacion()" persistible="true" capa_referenciada="Tipo Alimentacion"/>
	<atributo nombre="numero" tipo="java.lang.String" nillable="true"/>
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Point"/>
	<atributo nombre="tipo_conexion" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoConexion()" persistible="true" capa_referenciada="Tipo Conexion"/>
	<atributo nombre="potencia_contratada" nillable="true" tipo="java.lang.Integer"/>
	
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
	<atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    	<atributo nombre="Fact" tipo="java.util.Date"/>
    	
	<origen_datos>
		<workspace nombre="utap" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="e_utap_punto_alimentacion" nombre_mostrar="e_utap_punto_alimentacion"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS" />

		<tabla nombre="utap_punto_alimentacion" pk="gid" esquema="public">
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="cod_tipo_alimentacion" nombre_capa="tipo_alimentacion"/>
			<atributo_tabla nombre_bd="cod_tipo_conexion" nombre_capa="tipo_conexion"/>
			
			<atributo_tabla nombre_bd="nro_cuenta" nombre_capa="nro_cuenta"/>
			<atributo_tabla nombre_bd="numero" nombre_capa="numero"/>
			<atributo_tabla nombre_bd="cod_tipo_conexion" nombre_capa="tipo_conexion"/>
			<atributo_tabla nombre_bd="potencia_contratada" nombre_capa="potencia_contratada"/>
									
			
			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>	
		</tabla>
	</origen_datos>
</capa>
</tema>
