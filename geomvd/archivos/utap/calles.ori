<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="c_calles">

	<atributo nombre="nombre" tipo="java.lang.String"/>
	<atributo nombre="codigo" tipo="java.lang.Integer"/>
  	<atributo nombre="gid" tipo="java.lang.Integer"/>
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.LineString"/>  
	<origen_datos>
		<workspace nombre="utap" tipo="WMS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="c_calles" nombre_mostrar="c_calles"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="v_mdg_tramos_vias">
			<atributo_tabla nombre_bd="nombre" nombre_capa="nombre"/>
			<atributo_tabla nombre_bd="cod_nombre_via" nombre_capa="codigo"/>
			<atributo_tabla nombre_bd="gid" nombre_capa="gid"/>
		</tabla>
	</origen_datos>
</capa>
</tema>
