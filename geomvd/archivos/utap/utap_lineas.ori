<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="e_utap_tramo_linea">
	<atributo nombre="punto_alimentacion" tipo="imm.gis.core.feature.FeatureReferenceAttribute" capa_referenciada="utap:e_utap_punto_alimentacion" nillable="true" />
	<atributo nombre="desc_tipo_conductor" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoConductor()" persistible="true" capa_referenciada="Tipo Conductor"/>
	<atributo nombre="desc_tipo_tendido" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoTendido()" persistible="true" capa_referenciada="Tipo Tendido" nillable="true"/>
	<atributo nombre="tipo_cable" tipo="imm.gis.core.feature.ExternalAttribute" valorCalculado="python::getTipoCable()" persistible="true" capa_referenciada="Tipo Cable" />
	<atributo nombre="compra_cable" tipo="java.lang.String" nillable="true" />
	<atributo nombre="lote_cable" tipo="java.lang.String" nillable="true" />
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.LineString"/>
	
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
	<atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    	<atributo nombre="Fact" tipo="java.util.Date"/>
    	
	<origen_datos>
		<workspace nombre="utap" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="e_utap_tramo_linea" nombre_mostrar="e_utap_tramo_linea"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS" />

		<tabla nombre="utap_tramo_linea" pk="gid" esquema="public">
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="cod_tipo_conductor" nombre_capa="desc_tipo_conductor"/>
			<atributo_tabla nombre_bd="cod_tipo_tendido" nombre_capa="desc_tipo_tendido"/>
			<atributo_tabla nombre_bd="id_punto_alimentacion" nombre_capa="punto_alimentacion"/>
			<atributo_tabla nombre_bd="cod_tipo_cable" nombre_capa="tipo_cable"/>
			
			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>	
		</tabla>
	</origen_datos>	
</capa>
</tema>
