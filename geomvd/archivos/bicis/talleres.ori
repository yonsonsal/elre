<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="Talleres_Reparación" grupo="Capas editables">
	<atributo nombre="nombre" tipo="java.lang.String" nillable="true" valorCalculado="python::getNombreTalleres()" persistible="true"/>	
	<atributo nombre="horarios" tipo="java.lang.String" nillable="true" valorCalculado="python::getHorariosTalleres()" persistible="true"/>	
	<atributo nombre="servicios" tipo="java.lang.String" nillable="true" valorCalculado="python::getServiciosTalleres()" persistible="true"/>

	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
	<atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    	<atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>	
		
    	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Point"/>	 	
  		
	<origen_datos>
		<workspace nombre="bicis" tipo="WFS">
			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="Talleres_Reparación" nombre_mostrar="Talleres_Reparación"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="bi_talleres" esquema="ciudadanos" pk="gid" secuencia="ciudadanos.s_bi_tllr">	
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="nombre" nombre_capa="nombre"/>			
			<atributo_tabla nombre_bd="horarios" nombre_capa="horarios"/>			
			<atributo_tabla nombre_bd="servicios" nombre_capa="servicios"/>			
			
			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>				
  			
		</tabla>
	</origen_datos>
    </capa>
</tema>

