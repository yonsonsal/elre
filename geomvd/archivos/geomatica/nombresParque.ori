			<style strokeColor="#FF00A6" strokeWidth="1" fillColor="#000000BA" />
			<capapublicada nombre="mdg_nombres_parques" nombre_mostrar="mdg_nombres_parques"></capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="mdg_nombres_parques" esquema="public" pk="cod_nom_parque" comboValue="cod_nom_parque" comboLabel="nom_parque">	
			<atributo_tabla nombre_bd="nom_parque" nombre_capa="cod_nom_parque"/>
		</tabla>
	</origen_datos>
    </capa>
</tema>

