<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="e_git_velocidades_tramos" grupo="Capas editables">

	<atributo nombre="nombre" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Nombres Vias"/>
	<atributo nombre="nombre_via_desde" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Nombres Vias Desde"/>
	<atributo nombre="nombre_via_hasta" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Nombres Vias Hasta"/>

	<atributo nombre="vel_maxima" tipo="java.lang.Integer"/>	

	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
        <atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    	<atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>	
	
        <atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.LineString"/>	 	
	

  		
	<origen_datos>
                <workspace nombre="git" tipo="WFS">
			<style strokeColor="#0000FF"  strokeWidth="3"  fillColor="#000000AA" />
			<capapublicada nombre="e_git_velocidades_tramos" nombre_mostrar="Velocidad Tramos">
			</capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="git_velocidades_tramos" pk="gid" secuencia="gid_global_seq" esquema ="internos">	
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="cod_nombre_via" nombre_capa="nombre"/>
			<atributo_tabla nombre_bd="cod_nombre_via_desde" nombre_capa="nombre_via_desde"/>
			<atributo_tabla nombre_bd="cod_nombre_via_hasta" nombre_capa="nombre_via_hasta"/>

			<atributo_tabla nombre_bd="vel_maxima" nombre_capa="vel_maxima"/>
		
				
  			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>				
		
		</tabla>
	</origen_datos>
    </capa>
</tema>


