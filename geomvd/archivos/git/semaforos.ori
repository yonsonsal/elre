<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="e_int_semaforos" grupo="Capas editables">
	<atributo nombre="nroSenial" tipo="java.lang.Integer"/>	
	<atributo nombre="ubicacion" tipo="java.lang.String"/>
	<atributo nombre="anioInstalacion" tipo="java.lang.Integer"/>	
	<atributo nombre="tipo" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Tipos Semaforos"/>
	<atributo nombre="colsRectas" tipo="java.lang.Integer"/>
	<atributo nombre="colsPescantes" tipo="java.lang.Integer"/>
	<atributo nombre="fechaInstalacion" tipo="java.util.Date" nillable="true"/>
	<atributo nombre="expediente" tipo="java.lang.String"/>

	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
    <atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    <atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>	
	
    <atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Point"/>	 	
	

  		
	<origen_datos>
		<workspace nombre="git" tipo="WFS">
			<style strokeColor="#0000FF"  strokeWidth="3"  fillColor="#000000AA" />
			<capapublicada nombre="e_int_semaforos" nombre_mostrar="Semáforos">
			</capapublicada>
		</workspace>
		<fuente nombre="nucleoDS" tipo="POSTGIS"/>
		<tabla nombre="int_semaforos" esquema="public" pk="gid">	
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="nro_senial" nombre_capa="nroSenial"/>
			<atributo_tabla nombre_bd="ubicacion" nombre_capa="ubicacion"/>
			<atributo_tabla nombre_bd="anio_instalacion" nombre_capa="anioInstalacion"/>
			<atributo_tabla nombre_bd="tipo_semaforo" nombre_capa="tipo"/>			
			<atributo_tabla nombre_bd="cols_rectas" nombre_capa="colsRectas"/>			
  			<atributo_tabla nombre_bd="cols_pescantes" nombre_capa="colsPescantes"/>	
  			<atributo_tabla nombre_bd="fecha_instalacion" nombre_capa="fechaInstalacion"/>			
			<atributo_tabla nombre_bd="expediente" nombre_capa="expediente"/>	
				
  			<atributo_tabla nombre_bd="idauditoria" nombre_capa="idauditoria"/>			
			<atributo_tabla nombre_bd="ucrea" nombre_capa="Ucrea"/>
			<atributo_tabla nombre_bd="fcrea" nombre_capa="Fcrea"/>
			<atributo_tabla nombre_bd="uact" nombre_capa="Uact"/>
			<atributo_tabla nombre_bd="fact" nombre_capa="Fact"/>				
		
		</tabla>
	</origen_datos>
    </capa>
</tema>

