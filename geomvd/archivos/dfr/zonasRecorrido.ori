<?xml version="1.0" encoding="UTF-8"?>
<tema>
<capa nombre="E_DF_ZONA_RECORRIDO" grupo="Capas editables">
	<atributo nombre="recorrido" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Codigo Recorrido"/>
	<atributo nombre="fechaDesde" tipo="java.util.Date" />
	<atributo nombre="fechaHasta" tipo="java.util.Date" nillable="true"/>
	<atributo nombre="MUNICIPIO" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Nombres Municipio" valorCalculado="uy.ciemsa.geomvd.dfr.fields.ZonasRecorridoCalcs::getMunicipio(THE_GEOM)" persistible="true"/>	
	<atributo nombre="estado" tipo="imm.gis.core.feature.ExternalAttribute" capa_referenciada="Estado Zona Recorrido"/>	
	<atributo nombre="ultimoEnvioSimplifica" tipo="java.util.Date" nillable="true"/>
	<atributo nombre="idauditoria" tipo="java.lang.String"/>	
    <atributo nombre="Ucrea" tipo="java.lang.String" />
	<atributo nombre="Fcrea" tipo="java.util.Date" />
	<atributo nombre="Uact" tipo="java.lang.String" />
    <atributo nombre="Fact" tipo="java.util.Date" nillable="true"/>		
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.Polygon"/>
	
	<origen_datos>
		<workspace nombre="dfr" tipo="WFS">
			<style strokeColor="#FF00A6"  strokeWidth="1"  fillColor="#000000BA" /> 
			<capapublicada nombre="E_DF_ZONA_RECORRIDO" nombre_mostrar="E_DF_ZONA_RECORRIDO">
			</capapublicada>
		</workspace>
		<fuente nombre="brfDS" tipo="ORACLE"/>
		<tabla nombre="DF_ZONA_RECORRIDO" pk="GID" secuencia="s_dfzore">
			<atributo_tabla nombre_bd="GID" nombre_capa="gid" />
			<atributo_tabla nombre_bd="COD_RECORRIDO" nombre_capa="recorrido"/>
			<atributo_tabla nombre_bd="FECHA_DESDE" nombre_capa="fechaDesde"/>			
			<atributo_tabla nombre_bd="FECHA_HASTA" nombre_capa="fechaHasta"/>	
			<atributo_tabla nombre_bd="MUNICIPIO" nombre_capa="MUNICIPIO"/>
			<atributo_tabla nombre_bd="ESTADO" nombre_capa="estado"/>
			<atributo_tabla nombre_bd="ULTIMO_ENVIO_SIMPLIFICA" nombre_capa="ultimoEnvioSimplifica"/>				
  			<atributo_tabla nombre_bd="IDAUDITORIA" nombre_capa="idauditoria" />
			<atributo_tabla nombre_bd="UCREA" nombre_capa="Ucrea" />
			<atributo_tabla nombre_bd="FCREA" nombre_capa="Fcrea" />
			<atributo_tabla nombre_bd="UACT" nombre_capa="Uact" />
			<atributo_tabla nombre_bd="FACT" nombre_capa="Fact" />			

		</tabla>
	</origen_datos>
</capa>
