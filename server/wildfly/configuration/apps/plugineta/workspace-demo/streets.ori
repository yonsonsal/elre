<?xml version="1.0" encoding="UTF-8"?>
<tema>
    <capa nombre="streets" grupo="Capas editables">
	<!-- Atributos editables -->
	<atributo nombre="name" tipo="java.lang.String" nillable="true"/>
	<atributo nombre="streetType" tipo="java.lang.String" nillable="true"/>
	<atributo nombre="lengthM" tipo="java.lang.Float" nillable="true"/>

	<!-- Atributos de auditoría (no editables) -->
	<atributo nombre="createdAt" tipo="java.util.Date" nillable="true"/>
	<atributo nombre="updatedAt" tipo="java.util.Date" nillable="true"/>
	<atributo nombre="createdBy" tipo="java.lang.String" nillable="true"/>

	<!-- Geometría -->
	<atributo nombre="the_geom" tipo="com.vividsolutions.jts.geom.LineString"/>

	<origen_datos>
		<workspace nombre="workspace-demo" tipo="WFS">
			<style strokeColor="#4ECDC4" strokeWidth="3" fillColor="#4ECDC4BA" />
			<capapublicada nombre="streets" nombre_mostrar="Streets"></capapublicada>
		</workspace>
		<fuente nombre="pluginetaDS" tipo="POSTGIS"/>
		<tabla nombre="streets" esquema="example_data" pk="gid" secuencia="example_data.streets_gid_seq">
			<atributo_tabla nombre_bd="gid" nombre_capa="gid" />
			<atributo_tabla nombre_bd="name" nombre_capa="name"/>
			<atributo_tabla nombre_bd="street_type" nombre_capa="streetType"/>
			<atributo_tabla nombre_bd="length_m" nombre_capa="lengthM"/>
			<atributo_tabla nombre_bd="created_at" nombre_capa="createdAt"/>
			<atributo_tabla nombre_bd="updated_at" nombre_capa="updatedAt"/>
			<atributo_tabla nombre_bd="created_by" nombre_capa="createdBy"/>
		</tabla>
	</origen_datos>
    </capa>
</tema>
